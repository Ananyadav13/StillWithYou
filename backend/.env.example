# Copy this file to backend/.env and adjust as needed.
# Every value here is optional — the defaults in app/core/config.py match this file.

APP_NAME=StillWithYou API
ENVIRONMENT=development

# Comma-separated list of browser origins allowed to call the API.
# The Vite dev server runs on port 5173.
CORS_ORIGINS=http://localhost:5173

# Unused in Session 1; reserved for a later session.
# GEMINI_API_KEY=
