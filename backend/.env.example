# Copy this file to backend/.env and adjust as needed.
# Every value here is optional except GEMINI_API_KEY — the defaults in
# app/core/config.py match every other value in this file.

APP_NAME=StillWithYou API
ENVIRONMENT=development

# Comma-separated list of browser origins allowed to call the API.
# The Vite dev server runs on port 5173.
CORS_ORIGINS=http://localhost:5173

# Postgres, brought up by docker-compose at the repo root.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/stillwithyou

# Google AI Studio key. Required for real analysis; without it every message is
# still persisted, it just comes back with analysis: null.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Hard ceiling for a single Gemini call. Past this a call is a timeout failure.
GEMINI_TIMEOUT_SECONDS=3.0
